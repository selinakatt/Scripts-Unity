using UnityEngine;
using UnityEngine.InputSystem;

public class Cam2First : MonoBehaviour
{
        private Transform p; // Referencia al jugador (Player)
        public float sensitivity = 100f;
        private float xRotation = 0f;


        void Start()
        {
        //Encuentro objeto con el tag Player
            p = GameObject.FindWithTag("Player").GetComponent<Transform>();

          //Bloqueo el cursor
            Cursor.lockState = CursorLockMode.Locked;
        }


        void Update()
        {
        //Version con sistema nuevo
        //delta representa cuánto se movió el mouse desde la última lectura.
        Vector2 mouseInput = Mouse.current.delta.ReadValue();

        xRotation -= mouseInput.y;//Obtengo input vertical del mouse
       xRotation = Mathf.Clamp(xRotation, -90f, 90f); //El clamp limita el valor

        //muevo los objetos en base a la info recolectada
        //Unity internamente utiliza Quaternions para guardar las rotaciones.
        //Los ángulos Euler son una forma sencilla de representar una rotación
        //usando 3 valores: x, y, z
        transform.localRotation = Quaternion.Euler(xRotation, 0f, 0f);
        

        //Muevo al personaje con el Input X("Horizontal") del mouse
        //Como la camara esta dentro del personaje, se mueven juntos
        p.Rotate(Vector3.up * mouseInput.x);
        //(0,1,0)* Input del Mouse

        


        /*
         ----Version con el sistema viejo----
           
        //utilizo getaxis para obtenr los dos ejes del mouse
            float mouseX = Input.GetAxis("Mouse X") * sensitivity * Time.deltaTime;
            float mouseY = Input.GetAxis("Mouse Y") * sensitivity * Time.deltaTime;
        

        xRotation -= mouseY;
            xRotation = Mathf.Clamp(xRotation, -90f, 90f);
            transform.localRotation = Quaternion.Euler(xRotation, 0f, 0f);
            p.Rotate(Vector3.up * mouseX);
        */
    }
    }
